%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "13px",
    "fontFamily": "ui-sans-serif, system-ui, sans-serif"
  }
}}%%
flowchart LR

    %% ── External ────────────────────────────────────────────────────────────
    subgraph EXT["  External  "]
        direction TB
        GITHUB["GitHub API\napi.github.com/events"]
        TOKENS["Token Pool\n3 PAT · 5 000 req/h"]
    end

    %% ── Docker Compose Stack ────────────────────────────────────────────────
    subgraph DOCKER["  Docker Compose Stack — github-stream network  "]
        direction LR

        subgraph ING["  Data Ingestion  "]
            PROD["Producer\nPython · 10 s poll\nETag dedup"]
        end

        subgraph BRK["  Message Broker  "]
            direction TB
            KAFKA["Kafka KRaft\n3 partitions · 48 h"]
            KUI["Kafka UI\nPort 8080"]
        end

        subgraph PRC["  Processing & Enrichment  "]
            direction TB
            CONS["Consumer(s)\n1–3 instances\nGraphQL batch 20"]
            DBW["DB Writer\nrequest logs\nratelimit snapshots"]
            GEO["Geocoder Client\nPython · 1 req/s"]
            PHO(["Photon\nOpenStreetMap · Port 2322"])
        end

        subgraph STO["  Data Storage  "]
            TSB[("TimescaleDB\nPostgreSQL 16 · Port 5432\nhypertables · cont. aggs\n90 d retention")]
        end

        subgraph APIL["  API Layer  "]
            FAST["FastAPI · Port 8000\nREST + SSE\nAPScheduler · Hidden Gems"]
        end

        subgraph VIZ["  Visualization  "]
            direction TB
            NEXT["Next.js · Port 3000\nReact · Tremor · Globe GL"]
            GRAF["Grafana · Port 3001\n7 dashboards · read-only SQL"]
        end
    end

    USER(["End User\nBrowser"])

    %% ── Data flow arrows ────────────────────────────────────────────────────

    %% External → Ingestion
    GITHUB -->|"HTTP GET /events"| PROD

    %% Ingestion → Broker  (3 Kafka topics published)
    PROD -->|"events.raw\nevents.status\nratelimit"| KAFKA

    %% Broker internal monitoring link
    KAFKA -->|"metrics"| KUI

    %% Broker → Processing  (fan-out to 3 consumers)
    KAFKA -->|"events.raw"| CONS
    KAFKA -->|"events.status\nratelimit"| DBW
    KAFKA -->|"geocoder.req"| GEO

    %% Consumer loopback: queues geocoder requests asynchronously
    CONS -.->|"geocoder.req\nasync thread"| KAFKA

    %% Processing → Storage
    CONS -->|"INSERT events\nUPSERT users/repos/orgs"| TSB
    DBW  -->|"INSERT logs"| TSB
    GEO <-->|"HTTP geocode"| PHO
    GEO  -->|"UPDATE lat/lng/country"| TSB

    %% Storage → API + direct Grafana
    TSB -->|"asyncpg"| FAST
    TSB -->|"direct SQL"| GRAF

    %% API → Frontend
    FAST -->|"REST + SSE"| NEXT

    %% User access
    USER -->|"Port 3000"| NEXT
    USER -->|"Port 3001"| GRAF

    %% ── Auth arrows (dashed, secondary) ────────────────────────────────────
    TOKENS -.->|"events auth"| PROD
    TOKENS -.->|"GraphQL auth"| CONS

    %% ── Styles (match TikZ colour palette) ─────────────────────────────────
    classDef ext  fill:#C5CAE9,stroke:#5C6BC0,color:#1a237e
    classDef ing  fill:#81D4FA,stroke:#0288D1,color:#01234a
    classDef brk  fill:#FFCC80,stroke:#EF6C00,color:#3e2723
    classDef prc  fill:#A5D6A7,stroke:#2E7D32,color:#1b3a1c
    classDef sto  fill:#CE93D8,stroke:#6A1B9A,color:#1a0030
    classDef api  fill:#FFF176,stroke:#F57F17,color:#33291a
    classDef viz  fill:#F48FB1,stroke:#AD1457,color:#1a0010

    class GITHUB,TOKENS,USER ext
    class PROD ing
    class KAFKA,KUI brk
    class CONS,DBW,GEO,PHO prc
    class TSB sto
    class FAST api
    class NEXT,GRAF viz
