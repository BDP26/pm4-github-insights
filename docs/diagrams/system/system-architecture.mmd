graph LR
    %% Externe Quelle
    GH["GitHub API"] -->|"GET /events"| Prod["Producer (Python)"]

    %% Kern-System (Docker Stack)
    subgraph Docker_Stack["Docker Compose Stack (github-stream)"]
        
        %% Ingestion & Broker
        Prod -->|"events.raw"| Kafka["Kafka (KRaft)"]
        
        %% Verarbeitung & Anreicherung
        Kafka -->|"events.raw"| Cons["Consumer(s)"]
        Cons <-->|"geocoder.req"| Geo["Geocoder & Photon"]
        
        %% Log-Verarbeitung
        Kafka -->|"events.status / ratelimit"| DBW["DB Writer"]
        
        %% Speicherung
        Cons -->|"INSERT / UPSERT"| DB[("TimescaleDB (PostgreSQL)")]
        DBW -->|"INSERT logs"| DB
        
        %% API & Visualisierung
        DB -->|"Datenabruf (asyncpg)"| API["FastAPI"]
        DB -->|"SQL (Read-only)"| Grafana["Grafana"]
        
        API -->|"REST / SSE"| Front["Next.js Frontend"]
    end

    %% Endbenutzer
    Front -->|"Port 3000"| User(("Endbenutzer"))
    Grafana -->|"Port 3001"| User

    %% --- Farben und Styling für wissenschaftliche Reports ---
    
    %% Definition der Farbpaletten (Gedeckte Pastelltöne, dunkle Ränder für hohen Kontrast)
    classDef external fill:#F4F6F6,stroke:#5D6D7E,stroke-width:2px,color:#17202A;
    classDef ingestion fill:#EBF5FB,stroke:#2874A6,stroke-width:2px,color:#17202A;
    classDef broker fill:#FEF5E7,stroke:#D35400,stroke-width:2px,color:#17202A;
    classDef processing fill:#EAFAF1,stroke:#1E8449,stroke-width:2px,color:#17202A;
    classDef storage fill:#F4ECF7,stroke:#6C3483,stroke-width:2px,color:#17202A;
    classDef api fill:#FCF3CF,stroke:#B7950B,stroke-width:2px,color:#17202A;
    classDef viz fill:#EAECEE,stroke:#34495E,stroke-width:2px,color:#17202A;
    classDef userNode fill:#FFFFFF,stroke:#212F3D,stroke-width:2px,color:#17202A;

    %% Zuweisung der Klassen zu den Knoten
    class GH external;
    class Prod ingestion;
    class Kafka broker;
    class Cons,Geo,DBW processing;
    class DB storage;
    class API api;
    class Grafana,Front viz;
    class User userNode;
    
    %% Styling für den Subgraph (Sehr subtiler Hintergrund, grauer gestrichelter Rahmen)
    style Docker_Stack fill:#FCFCFC,stroke:#B2BABB,stroke-width:2px,stroke-dasharray: 5 5,color:#5D6D7E;