          "rawQuery": true,
          "rawSql": "SELECT\n  received_at AS \"time\",\n  CASE \n    WHEN url LIKE '%/events%' THEN 'Events-Key'\n    WHEN url LIKE '%/users/%' AND url NOT LIKE '%/events%' THEN 'User-Key'\n    WHEN url LIKE '%/repos/%' THEN 'Repo-Key'\n    ELSE 'Other'\n  END AS metric,\n  (response_headers::json->>'X-RateLimit-Used')::int AS \"Used\"\nFROM request_logs\nWHERE $__timeFilter(received_at)\nORDER BY 1;",
