        {
          "dataset": "github_events",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (bereich)\n  bereich AS \"API Key\",\n  sent_at AS \"Letzter Limit-Hit\",\n  -- Hier ersetzen wir die Basis-URL durch [...]\n  REPLACE(url, 'https://api.github.com', '[...]') AS \"Pfad (Letzter Fail)\",\n  status_code AS \"Status\"\nFROM (\n  SELECT \n    CASE \n      WHEN url LIKE '%/events%' THEN '1. Events (Producer)'\n      WHEN url LIKE '%/users/%' THEN '2. Users (Consumer)'\n      WHEN url LIKE '%/repos/%' THEN '3. Repos (Consumer)'\n      ELSE 'Andere'\n    END AS bereich,\n    sent_at,\n    url,\n    status_code\n  FROM request_logs\n  WHERE \n    ((response_headers::json->>'X-RateLimit-Remaining')::int = 0 OR status_code = 403)\n    AND sent_at > NOW() - INTERVAL '7 days'\n  ORDER BY sent_at DESC\n) sub\nWHERE bereich != 'Andere'\nORDER BY bereich, sent_at DESC;",
          "refId": "A",
          "sql": {
