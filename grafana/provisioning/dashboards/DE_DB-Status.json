        {
          "dataset": "github_events",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  received_at,\n  status_code,\n  reason,\n  CASE\n    WHEN url ~ '^https://api\\.github\\.com/users/[^/]+$'       THEN 'User'\n    WHEN url ~ '^https://api\\.github\\.com/repos/[^/]+/[^/]+'  THEN 'Repo'\n    WHEN url ~ '^https://api\\.github\\.com/events(\\?.*)?$'      THEN 'Event'\n    ELSE 'Unknown'\n  END AS request_type,\n  CASE\n    WHEN url ~ '^https://api\\.github\\.com/users/[^/]+$'       THEN substring(url FROM '^https://api\\.github\\.com/users/([^/]+)$')\n    WHEN url ~ '^https://api\\.github\\.com/repos/[^/]+/[^/]+'  THEN substring(url FROM '^https://api\\.github\\.com/repos/([^/]+/[^/]+)')\n    ELSE NULL\n  END AS entity\nFROM request_logs\nWHERE NOT request_success\nORDER BY received_at DESC\nLIMIT 10;",
          "refId": "A",
