          "rawSql": "SELECT\n  $__timeGroupAlias(received_at, 1m), -- Gruppiert die Daten pro Minute\n  CASE \n    WHEN url LIKE '%/events%' THEN 'Events-Key'\n    WHEN url LIKE '%/users/%' THEN 'User-Key'\n    WHEN url LIKE '%/repos/%' THEN 'Repo-Key'\n    ELSE 'Other'\n  END AS metric,\n  MAX((response_headers::json->>'X-RateLimit-Used')::int) AS \"Used\"\nFROM request_logs\nWHERE $__timeFilter(received_at)\n  AND response_headers IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1;",
