      "targets": [
        {
          "dataset": "github_events",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_logs AS (\n  -- Wir greifen uns nur die absolut letzten 1000 Zeilen. \n  -- Dank Index auf sent_at oder id geht das in Millisekunden.\n  SELECT * FROM request_logs \n  WHERE sent_at IS NOT NULL\n  ORDER BY sent_at DESC \n  LIMIT 15000\n)\nSELECT DISTINCT ON (bereich)\n  bereich AS \"API Key\",\n  verbraucht AS \"Verbrauchte Requests\",\n  restlich AS \"Restliche Requests\",\n  TO_TIMESTAMP(reset_timestamp) AS \"Neue Requests\"\nFROM (\n  SELECT \n    CASE \n      WHEN url LIKE '%/events%' THEN '1. Events (Producer)'\n      WHEN url LIKE '%/users/%' THEN '2. Users (Consumer)'\n      WHEN url LIKE '%/repos/%' THEN '3. Repos (Consumer)'\n      ELSE 'Andere'\n    END AS bereich,\n    (response_headers::json->>'X-RateLimit-Used')::int AS verbraucht,\n    (response_headers::json->>'X-RateLimit-Remaining')::int AS restlich,\n    (response_headers::json->>'X-RateLimit-Reset')::bigint AS reset_timestamp,\n    sent_at\n  FROM last_logs\n) sub\nWHERE bereich != 'Andere'\nORDER BY bereich, sent_at DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "API-Request Overview",
      "type": "table"
