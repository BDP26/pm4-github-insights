GITHUB_TOKEN_USER=your_github_api_key_here
GITHUB_TOKEN_REPO=your_github_api_key_here
GITHUB_TOKEN_EVENTS=your_github_api_key_here
GF_SECURITY_ADMIN_PASSWORD=admin12345

# Multi-instance consumer (opt-in) — see docs/ENV.md for details
# KAFKA_MULTI_INSTANCE_ENABLED=false
# KAFKA_INSTANCE_INDEX=0
# KAFKA_TOTAL_INSTANCES=3

# Hidden Gems Scheduler (opt-in overrides) — see docs/ENV.md for details
# SNAPSHOT_INTERVALS=24,168,730
# SNAPSHOT_ALPHA=1.0
# SNAPSHOT_BETA=1.0
# SNAPSHOT_MIN_STARS=5
# SNAPSHOT_MIN_FORKS=1
# SNAPSHOT_TOP_N=1000