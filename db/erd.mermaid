erDiagram
    users ||--o{ events : "triggers"
    users ||--o{ repos : "owns (personal)"
    organizations ||--o{ repos : "owns (org-level)"
    repos ||--o{ events : "is target of"

    users ||--o{ organization_members : "is member of"
    organizations ||--o{ organization_members : "has"

    users {
        TEXT username PK "login"
        TIMESTAMPTZ fetched_at
        TEXT company "Literal string from profile"
        TEXT location
        TEXT country
        CHAR country_code
        DOUBLE_PRECISION lat
        DOUBLE_PRECISION lng
        INTEGER public_repos
        INTEGER followers
        TIMESTAMPTZ last_active
    }

    organizations {
        TEXT login PK
        TIMESTAMPTZ fetched_at
        TEXT name
        TEXT description
        TEXT location
        DOUBLE_PRECISION lat
        DOUBLE_PRECISION lng
        BOOLEAN is_verified
        INTEGER public_repos
        TIMESTAMPTZ created_at
    }

    organization_members {
        TEXT org_login FK "Ref organizations.login"
        TEXT user_username FK "Ref users.username"
        TEXT role "e.g. member, admin"
    }

    repos {
        INTEGER repo_id PK "id"
        TIMESTAMPTZ fetched_at
        TEXT name
        TEXT full_name
        TEXT owner_login FK "Can be user or org login"
        TEXT owner_type "User OR Organization"
        TEXT description
        TEXT language
        TEXT license_spdx
        TEXT[] topics
        INTEGER stargazers_count
        INTEGER forks_count
        INTEGER size
        TIMESTAMPTZ created_at
        TIMESTAMPTZ pushed_at
    }

    events {
        TIMESTAMPTZ time PK
        TEXT event_id PK
        TEXT event_type
        TEXT actor_username FK "Ref users.username"
        INTEGER repo_id FK "Ref repos.repo_id"
        TEXT detail
        JSONB payload
    }