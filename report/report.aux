\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Core star schema. \texttt  {events} is the central fact hypertable; \texttt  {users}, \texttt  {repos}, and \texttt  {organizations} are dimension tables; \texttt  {organization\_members} is a junction table with enforced \texttt  {REFERENCES} constraints. Dashed arrows from \texttt  {events} to \texttt  {users} and \texttt  {repos} represent logical joins (no database-level FK constraint); arrows from \texttt  {organization\_members} represent actual \texttt  {REFERENCES} constraints.}}{11}{figure.caption.31}\protected@file@percent }
\newlabel{fig:db-core}{{3}{11}{Core star schema. \texttt {events} is the central fact hypertable; \texttt {users}, \texttt {repos}, and \texttt {organizations} are dimension tables; \texttt {organization\_members} is a junction table with enforced \texttt {REFERENCES} constraints. Dashed arrows from \texttt {events} to \texttt {users} and \texttt {repos} represent logical joins (no database-level FK constraint); arrows from \texttt {organization\_members} represent actual \texttt {REFERENCES} constraints}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hidden Gem snapshot tables. \texttt  {hidden\_gem\_snapshot\_runs} is the header record for each scoring run (one per interval per invocation); the three child tables store per-repo, per-user, and per-org significance scores for that run.}}{12}{figure.caption.32}\protected@file@percent }
\newlabel{fig:db-snapshots}{{4}{12}{Hidden Gem snapshot tables. \texttt {hidden\_gem\_snapshot\_runs} is the header record for each scoring run (one per interval per invocation); the three child tables store per-repo, per-user, and per-org significance scores for that run}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Operational log tables. These three tables record HTTP request logs for the GitHub REST/GraphQL API (\texttt  {request\_logs}), GitHub API rate-limit snapshots (\texttt  {rate\_limit\_snapshots}), and Photon geocoder request logs (\texttt  {geocoder\_request\_logs}). They carry no foreign key references to the core schema and are used exclusively for operational monitoring.}}{12}{figure.caption.33}\protected@file@percent }
\newlabel{fig:db-operational}{{5}{12}{Operational log tables. These three tables record HTTP request logs for the GitHub REST/GraphQL API (\texttt {request\_logs}), GitHub API rate-limit snapshots (\texttt {rate\_limit\_snapshots}), and Photon geocoder request logs (\texttt {geocoder\_request\_logs}). They carry no foreign key references to the core schema and are used exclusively for operational monitoring}{figure.caption.33}{}}
